{
  "name": "opencode-muse",
  "version": "2.0.0",
  "description": "Muse Code in OpenCode with no approvals and two usage meters (fork of opencode-muse)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test ./test/run.ts",
    "probe:host-override": "bun test/probes/msp-host-override.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bearmancer/opencode-muse-v2.git"
  },
  "bugs": {
    "url": "https://github.com/Bearmancer/opencode-muse-v2/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "muse-code",
    "msp",
    "ai",
    "llm",
    "agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@muse-code/sdk": "1.4.14"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@opencode/plugin": "2.3.0",
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "@types/bun": "1.3.11",
    "@types/node": "22.15.0",
    "bun": "1.4.3",
    "solid-js": "^1.9.12",
    "typescript": "7.0.2",
    "typescript-5": "npm:typescript@5.9.3"
  }
}
